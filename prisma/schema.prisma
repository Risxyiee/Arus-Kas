generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  date        DateTime
  description String
  category    String
  type        String   // "income" or "expense"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Debt {
  id            String   @id @default(cuid())
  personName    String
  amount        Float
  paidAmount    Float    @default(0)
  dueDate       DateTime
  type          String   // "debt" or "receivable"
  status        String   @default("unpaid") // "unpaid", "partially_paid", "paid"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
